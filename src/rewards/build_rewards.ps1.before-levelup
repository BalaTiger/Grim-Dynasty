foreach($program in @('RewardQuestDemo','MoneyCatalogProbe','AdjustedQuestDemo','ExperienceQuestDemo')) {
 & $compiler /nologo /target:exe /checked+ /optimize+ /reference:System.Web.Extensions.dll @refs "/reference:$target\GrimDynasty.Resources.dll" "/reference:$target\GrimDynasty.Quests.dll" "/out:$target\$program.exe" "$PSScriptRoot\$program.cs" "$PSScriptRoot\ExampleRewardQuest.cs" "$PSScriptRoot\ExampleExperienceQuest.cs" $fixture
 if ($LASTEXITCODE -ne 0) {throw 'Reward demo/catalog compile failed'}
}
& "$target\RewardQuestDemo.exe"
if ($LASTEXITCODE -ne 0) {throw 'Reward demo failed'}
