& $compiler /nologo /target:exe /checked+ /optimize+ @refs "/out:$target\ExperienceRewardTests.exe" "$PSScriptRoot\ExperienceRewardTests.cs" "$PSScriptRoot\ExampleExperienceQuest.cs" $fixture
if ($LASTEXITCODE -ne 0) {throw 'Experience tests compile failed'}
& "$target\ExperienceRewardTests.exe"
