& $compiler /nologo /target:exe /checked+ /optimize+ @refs "/out:$target\AdjustedRewardTests.exe" "$PSScriptRoot\AdjustedRewardTests.cs" $fixture
if ($LASTEXITCODE -ne 0) {throw 'Adjusted reward tests compile failed'}
& "$target\AdjustedRewardTests.exe"
if ($LASTEXITCODE -ne 0) {throw 'Adjusted reward tests failed'}
& $compiler /nologo /target:exe /checked+ /optimize+ @refs "/out:$target\TributeRewardTests.exe" "$PSScriptRoot\TributeRewardTests.cs" $fixture
if ($LASTEXITCODE -ne 0) {throw 'Tribute tests compile failed'}
& "$target\TributeRewardTests.exe"
