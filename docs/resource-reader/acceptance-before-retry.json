  "quest": {
    "magic": "QST2",
    "version": 9,
    "bytes": 2182,
    "sha256": "465b46b8d0bd68a1fed16245713121bcf96b8f5f0af216158ca1461385bab243",
    "text_section_offset": 783,
    "locales": {
      "enUS": [
        {
          "length_prefix_offset": 799,
          "byte_length": 17,
          "text": "The Outlaw Threat"
        },
        {
          "length_prefix_offset": 820,
          "byte_length": 19,
          "text": "Murderers and Worse"
        },
        {
          "length_prefix_offset": 843,
          "byte_length": 15,
          "text": "Speak to Mornay"
        },
        {
          "length_prefix_offset": 862,
          "byte_length": 467,
          "text": "With the Warden threat dealt with, Captain Bourbon feels it is imperative to reopen the way northwest towards the once thriving farming community that supplied this region. That does not come without its own problems though. Bandits, former convicts from the prison, are rampant in that region and could pose a serious threat to Devil's Crossing. Mornay has just returned from Old Arkovia and should be able to provide information on their activities and whereabouts."
        },
        {
          "length_prefix_offset": 1333,
          "byte_length": 37,
          "text": "Speak with Mornay in Devil's Crossing"
        },
        {
          "length_prefix_offset": 1374,
          "byte_length": 0,
          "text": ""
        },
        {
          "length_prefix_offset": 1378,
          "byte_length": 0,
          "text": ""
        },
        {
          "length_prefix_offset": 1382,
          "byte_length": 0,
          "text": ""
        },
        {
          "length_prefix_offset": 1386,
          "byte_length": 0,
          "text": ""
        },
        {
          "length_prefix_offset": 1390,
          "byte_length": 29,
          "text": "Repair the bridge (skippable)"
        },
        {
          "length_prefix_offset": 1423,
          "byte_length": 203,
          "text": "Before you can venture out to the Arkovian Foothills to the northwest, the bridge must first be repaired. In order to repair the bridge, you must provide the necessary materials at its construction site."
        },
        {
          "length_prefix_offset": 1630,
          "byte_length": 59,
          "text": "Repair the bridge leading northwest out of Devil's Crossing"
        },
        {
          "length_prefix_offset": 1693,
          "byte_length": 0,
          "text": ""
        },
        {
          "length_prefix_offset": 1697,
          "byte_length": 11,
          "text": "Kill Edmund"
        },
        {
          "length_prefix_offset": 1712,
          "byte_length": 144,
          "text": "With the bridge repaired, you need to enter the Arkovian Foothills and let the outlaws know that Devil's Crossing is not a prize for the taking."
        },
        {
          "length_prefix_offset": 1860,
          "byte_length": 26,
          "text": "Kill Edmund \"Shanks\" Doyle"
        },
        {
          "length_prefix_offset": 1890,
          "byte_length": 0,
          "text": ""
        },
        {
          "length_prefix_offset": 1894,
          "byte_length": 16,
          "text": "Report to Mornay"
        },
        {
          "length_prefix_offset": 1914,
          "byte_length": 199,
          "text": "It is as Mornay feared. The outlaws are mobilizing against Devil's Crossing and it is only a matter of time before they attack. Report back to Mornay in Devil's Crossing to determine your next steps."
        },
        {
          "length_prefix_offset": 2117,
          "byte_length": 41,
          "text": "Report back to Mornay in Devil's Crossing"
        },
        {
          "length_prefix_offset": 2162,
